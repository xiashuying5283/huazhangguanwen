{
  "name": "expo-express-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "bash .cozeproj/scripts/dev_run.sh",
    "dev:local": "node --env-file-if-exists=.env scripts/dev-local.mjs",
    "build": "bash .cozeproj/scripts/prod_build.sh",
    "start": "bash .cozeproj/scripts/prod_run.sh",
    "preinstall": "npx only-allow pnpm",
    "lint:client": "pnpm --dir client exec tsc --noEmit && pnpm --dir client exec eslint . --quiet",
    "lint:server": "pnpm --dir server exec tsc --noEmit",
    "lint:all": "pnpm lint:client && pnpm lint:server",
    "validate": "pnpm dlx concurrently --group --names expo,server \"pnpm lint:client\" \"pnpm lint:server\"",
    "db:sql": "pnpm --dir server exec tsx scripts/export-supabase-sql.ts",
    "test:reading": "pnpm --dir server exec tsx --test tests/reading.test.cts",
    "db:verify": "pnpm --dir server exec tsx scripts/verify-migration.ts"
  },
  "dependencies": {},
  "devDependencies": {},
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.2"
    },
    "patchedDependencies": {
      "expo@54.0.33": "patches/expo@54.0.33.patch"
    }
  }
}
